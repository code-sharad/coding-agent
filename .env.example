# Neon PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# GitHub OAuth App credentials
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Secret used to sign Better Auth sessions (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=""

# OpenRouter API key (required) — https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# OpenRouter model slug; must support tool calling. Pick one at
# https://openrouter.ai/models?supported_parameters=tools
# Defaults to deepseek/deepseek-v4.1-flash-1017.
AGENT_MODEL=""

# Public URL of the app (e.g. http://localhost:3000 or https://your-domain.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
